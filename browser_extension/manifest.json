{
  "manifest_version": 3,
  "name": "Interactive Scrolling Bridge",
  "version": "0.2.0",
  "description": "Lets the Interactive Scrolling desktop app on this computer control YouTube Shorts in this browser after pairing.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shorts.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Interactive Scrolling", "default_popup": "popup.html" },
  "minimum_chrome_version": "116"
}
